#!/usr/bin/env node
const fs = require('node:fs');

const statePath = process.env.GH_STUB_STATE;
if (!statePath) {
  console.error('GH_STUB_STATE is required');
  process.exit(2);
}

const state = JSON.parse(fs.readFileSync(statePath, 'utf8'));
state.calls ??= [];
state.calls.push(process.argv.slice(2));
const args = process.argv.slice(2);

function save() {
  fs.writeFileSync(statePath, `${JSON.stringify(state, null, 2)}\n`);
}

function die(message) {
  save();
  console.error(message);
  process.exit(1);
}

function values(flag) {
  const found = [];
  for (let index = 0; index < args.length; index += 1) {
    if (args[index] === flag && args[index + 1] !== undefined) found.push(args[index + 1]);
  }
  return found;
}

function value(flag) {
  return values(flag).at(-1);
}

function issueNumber(position = 2) {
  const number = Number(String(args[position] ?? '').replace(/^#/, ''));
  if (!Number.isInteger(number) || number < 1) die(`invalid issue number: ${args[position] ?? ''}`);
  return number;
}

function issueByNumber(number) {
  const issue = state.issues.find((entry) => entry.number === number);
  if (!issue) die(`issue not found: ${number}`);
  return issue;
}

function labels(labels) {
  return labels.map((name) => ({ name }));
}

function assignees(logins) {
  return (logins ?? []).map((login) => ({ login }));
}

function select(object, fields) {
  if (!fields) return object;
  const selected = {};
  for (const field of fields.split(',')) selected[field] = object[field];
  return selected;
}

function validateJsonFields(fields, allowed) {
  for (const field of (fields ?? '').split(',').filter(Boolean)) {
    if (!allowed.has(field)) die(`Unknown JSON field: "${field}"`);
  }
}

function formFields(flag) {
  const fields = {};
  for (const entry of values(flag)) {
    const separator = entry.indexOf('=');
    if (separator === -1) die(`${flag} requires name=value`);
    fields[entry.slice(0, separator)] = entry.slice(separator + 1);
  }
  return fields;
}

function connectionPage(nodes, cursor, prefix, first = 100) {
  let start = 0;
  if (cursor !== undefined) {
    const match = new RegExp(`^${prefix}:(\\d+)$`).exec(cursor);
    if (!match) die(`invalid GraphQL cursor: ${cursor}`);
    start = Number(match[1]);
  }
  const pageNodes = nodes.slice(start, start + first);
  const end = start + pageNodes.length;
  return {
    nodes: pageNodes,
    pageInfo: {
      hasNextPage: end < nodes.length,
      endCursor: pageNodes.length > 0 ? `${prefix}:${end}` : cursor ?? null,
    },
  };
}

function graphqlValue(expression, variables) {
  if (expression.startsWith('$')) return variables[expression.slice(1)];
  if (expression === 'true') return true;
  if (expression === 'false') return false;
  if (/^\d+$/.test(expression)) return Number(expression);
  if (expression.startsWith('"')) return JSON.parse(expression);
  return expression;
}
function graphqlSelections(query, field) {
  const selections = [];
  const pattern = new RegExp(`(?:(\\w+)\\s*:\\s*)?${field}\\s*\\(([^)]*)\\)`, 'g');
  for (const match of query.matchAll(pattern)) {
    const args = new Map();
    for (const argument of match[2].split(',').map((part) => part.trim()).filter(Boolean)) {
      const separator = argument.indexOf(':');
      if (separator < 0) die(`invalid GraphQL argument: ${argument}`);
      args.set(argument.slice(0, separator).trim(), argument.slice(separator + 1).trim());
    }
    selections.push({ alias: match[1] ?? field, args });
  }
  return selections;
}

function graphqlPage(nodes, selection, variables, allowed) {
  for (const name of selection.args.keys()) {
    if (!allowed.includes(name)) die(`Unknown GraphQL argument: "${name}"`);
  }
  const first = graphqlValue(selection.args.get('first') ?? '100', variables);
  if (!Number.isInteger(first) || first < 1 || first > 100) die(`invalid GraphQL page size: ${first}`);
  const after = graphqlValue(selection.args.get('after') ?? '', variables) || undefined;
  return connectionPage(nodes, after, selection.alias, first);
}

function observeIssue(issue) {
  if (state.remoteChange?.issue !== issue.number) return;
  if (state.remoteChange.viewsBeforeChange > 0) {
    state.remoteChange.viewsBeforeChange -= 1;
  } else {
    issue.body = state.remoteChange.body ?? `${issue.body}\n`;
    touch(issue);
    delete state.remoteChange;
  }
}

function respondGraphql(data, stage) {
  const response = { data };
  const error = state.graphqlError;
  if (error && (error.on === undefined || error.on === stage)) {
    response.errors = Array.isArray(error) ? error : error.errors ?? [{ message: String(error.message ?? error) }];
    delete state.graphqlError;
  }
  const missing = state.graphqlMissingData;
  if (missing && (missing.on === undefined || missing.on === stage)) {
    response.data = missing.data ?? null;
    delete state.graphqlMissingData;
  }
  const missingCursor = state.graphqlMissingCursor;
  if (missingCursor && (missingCursor.on === undefined || missingCursor.on === stage)) {
    const connection = response.data?.repository?.issue?.[missingCursor.field];
    if (connection?.pageInfo?.hasNextPage !== true) die(`no next page for ${missingCursor.field}`);
    connection.pageInfo.endCursor = null;
    delete state.graphqlMissingCursor;
  }
  console.log(JSON.stringify(response));
  save();
  process.exit(0);
}

function commentJson(comment, issue) {
  const login = typeof comment.author === 'string' ? comment.author : comment.author?.login ?? comment.user?.login;
  return {
    id: comment.id,
    body: comment.body,
    author: login ? { login } : null,
    createdAt: comment.createdAt,
    updatedAt: comment.updatedAt ?? comment.createdAt,
    url: comment.url ?? `${issue.url}#issuecomment-${comment.id}`,
  };
}

function apiCommentJson(comment, issue) {
  const rendered = commentJson(comment, issue);
  return {
    id: rendered.id,
    body: rendered.body,
    user: rendered.author,
    created_at: rendered.createdAt,
    updated_at: rendered.updatedAt,
    html_url: rendered.url,
  };
}

function issueJson(issue) {
  return {
    ...issue,
    labels: labels(issue.labels),
    assignees: assignees(issue.assignees),
    comments: (issue.comments ?? []).map((comment) => commentJson(comment, issue)),
  };
}

function touch(issue) {
  state.clock = (state.clock ?? 0) + 1;
  issue.updatedAt = new Date(Date.parse('2026-08-20T20:00:00Z') + state.clock * 1000).toISOString();
}

const [group, command] = args;
const ISSUE_JSON_FIELDS = new Set([
  'number',
  'title',
  'body',
  'state',
  'stateReason',
  'labels',
  'assignees',
  'url',
  'createdAt',
  'updatedAt',
  'comments',
]);
const PR_JSON_FIELDS = new Set([
  'number',
  'title',
  'body',
  'state',
  'url',
  'mergedAt',
  'mergedBy',
  'mergeStateStatus',
  'baseRefName',
  'headRefName',
]);

const commentsEndpoint = /^repos\/([^/]+)\/([^/]+)\/issues\/([1-9]\d*)\/comments$/.exec(`${command ?? ''}`);
if (group === 'api' && commentsEndpoint) {
  if (!args.includes('--paginate') || !args.includes('--slurp')) die('issue comments api requires --paginate and --slurp');
  const repo = `${commentsEndpoint[1]}/${commentsEndpoint[2]}`;
  if (repo !== state.repo.nameWithOwner) die(`repository not found: ${repo}`);
  const issue = issueByNumber(Number(commentsEndpoint[3]));
  const comments = (issue.comments ?? []).map((comment) => apiCommentJson(comment, issue));
  const pages = [];
  for (let index = 0; index < comments.length; index += 100) pages.push(comments.slice(index, index + 100));
  if (pages.length === 0) pages.push([]);
  console.log(JSON.stringify(pages));
  save();
  process.exit(0);
}

const eventsEndpoint = /^repos\/([^/]+)\/([^/]+)\/issues\/([1-9]\d*)\/events$/.exec(`${command ?? ''}`);
if (group === 'api' && eventsEndpoint) {
  if (!args.includes('--paginate') || !args.includes('--slurp')) die('issue events api requires --paginate and --slurp');
  const repo = `${eventsEndpoint[1]}/${eventsEndpoint[2]}`;
  if (repo !== state.repo.nameWithOwner) die(`repository not found: ${repo}`);
  const issue = issueByNumber(Number(eventsEndpoint[3]));
  const events = issue.events ?? [];
  const pages = [];
  for (let index = 0; index < events.length; index += 100) pages.push(events.slice(index, index + 100));
  if (pages.length === 0) pages.push([]);
  console.log(JSON.stringify(pages));
  save();
  process.exit(0);
}

if (group === 'api' && command === 'graphql') {
  const query = formFields('-f').query;
  if (!query) die('graphql requires -f query=<query>');
  const variables = formFields('-F');
  const [owner, name] = state.repo.nameWithOwner.split('/');
  if (variables.owner === '{owner}') variables.owner = owner;
  if (variables.name === '{repo}') variables.name = name;
  if (`${variables.owner}/${variables.name}` !== state.repo.nameWithOwner)
    die(`repository not found: ${variables.owner}/${variables.name}`);
  if (state.repoError) die(state.repoError);
  if (query.includes('viewer') && state.viewerError) die(state.viewerError);
  const stage = query.includes('viewer') ? 'snapshot' : 'page';
  const referenceRepo = (reference) =>
    (typeof reference.repository === 'string' ? reference.repository : reference.repository?.nameWithOwner) ??
    (reference.repository?.owner?.login && reference.repository?.name
      ? `${reference.repository.owner.login}/${reference.repository.name}`
      : state.repo.nameWithOwner);
  const pullRequestNode = (reference) => {
    const repo = referenceRepo(reference);
    const pullRequest = (state.prs ?? []).find(
      (entry) => entry.number === reference.number && entry.repository === repo,
    );
    return {
      number: reference.number,
      url: pullRequest?.url ?? reference.url ?? `https://github.com/${repo}/pull/${reference.number}`,
      body: pullRequest?.body ?? reference.body ?? null,
      state: pullRequest?.state ?? reference.state ?? (pullRequest?.mergedAt || reference.mergedAt ? 'MERGED' : 'OPEN'),
      mergedAt: pullRequest?.mergedAt ?? reference.mergedAt ?? null,
      baseRefName: pullRequest?.baseRefName ?? reference.baseRefName ?? null,
      repository: { nameWithOwner: repo },
    };
  };
  const commitAssociations = (oid, selection) => {
    const commit = (state.commits ?? []).find(
      (entry) => entry.oid === oid && (entry.repository ?? state.repo.nameWithOwner) === state.repo.nameWithOwner,
    );
    if (!commit) die(`commit not found: ${state.repo.nameWithOwner}@${oid}`);
    return graphqlPage(
      (commit.associatedPullRequests ?? []).map(pullRequestNode),
      selection,
      variables,
      ['first', 'after'],
    );
  };
  const repository = {
    nameWithOwner: state.repo.nameWithOwner,
    visibility: state.repo.visibility,
  };
  if (query.includes('defaultBranchRef')) {
    const defaultBranch = state.repositoryDefaults?.[state.repo.nameWithOwner] ?? state.repo.defaultBranchRef?.name;
    repository.defaultBranchRef = defaultBranch ? { name: defaultBranch } : null;
  }

  const issueSelection = graphqlSelections(query, 'issue');
  const objectSelection = graphqlSelections(query, 'object');
  const labelSelections = graphqlSelections(query, 'label');
  if (issueSelection.length > 1 || objectSelection.length > 1) die('graphql selects multiple issues or objects');
  if (issueSelection.length) {
    const requestedNumber = graphqlValue(issueSelection[0].args.get('number'), variables);
    const issue = issueByNumber(Number(requestedNumber));
    if (stage === 'snapshot') observeIssue(issue);
    const payload = {
      number: issue.number,
      title: issue.title,
      body: issue.body,
      state: issue.state,
      stateReason: issue.stateReason,
      url: issue.url,
      createdAt: issue.createdAt,
      updatedAt: issue.updatedAt,
    };
    for (const selection of graphqlSelections(query, 'assignedActors')) {
      payload[selection.alias] = graphqlPage(assignees(issue.assignees), selection, variables, ['first', 'after']);
    }
    for (const selection of graphqlSelections(query, 'labels')) {
      payload[selection.alias] = graphqlPage(labels(issue.labels), selection, variables, ['first', 'after']);
    }
    for (const selection of graphqlSelections(query, 'comments')) {
      payload[selection.alias] = graphqlPage(
        (issue.comments ?? []).map((comment) => commentJson(comment, issue)),
        selection,
        variables,
        ['first', 'after'],
      );
    }
    for (const selection of graphqlSelections(query, 'timelineItems')) {
      const types = selection.args.get('itemTypes');
      if (types === '[LABELED_EVENT]' || types === 'LABELED_EVENT') {
        const events = (issue.events ?? [])
          .filter((event) => event.event === 'labeled')
          .map((event) => ({ label: event.label }));
        payload[selection.alias] = graphqlPage(events, selection, variables, ['first', 'after', 'itemTypes']);
      } else if (types === '[CLOSED_EVENT]' || types === 'CLOSED_EVENT') {
        for (const argument of selection.args.keys()) {
          if (!['last', 'itemTypes'].includes(argument)) die(`Unknown GraphQL argument: "${argument}"`);
        }
        const last = graphqlValue(selection.args.get('last') ?? '1', variables);
        if (last !== 1) die('latest closure must request last:1');
        const latest = (issue.timelineItems ?? [])
          .filter((event) => event.__typename === 'ClosedEvent' || Object.hasOwn(event, 'closer'))
          .at(-1);
        const closer = latest?.closer;
        let renderedCloser = closer;
        if (closer?.__typename === 'PullRequest') {
          renderedCloser = { __typename: 'PullRequest', ...pullRequestNode(closer) };
        }
        if (closer?.__typename === 'Commit') {
          const association = graphqlSelections(query, 'associatedPullRequests');
          renderedCloser = {
            __typename: 'Commit',
            oid: closer.oid,
            ...(association.length && {
              associatedPullRequests: commitAssociations(closer.oid, association[0]),
            }),
          };
        }
        payload[selection.alias] = { nodes: latest ? [{ closer: renderedCloser }] : [] };
      } else die(`unsupported timeline item types: ${types ?? '(missing)'}`);
    }
    repository.issue = payload;
  } else if (objectSelection.length) {
    const oid = graphqlValue(objectSelection[0].args.get('expression'), variables);
    const association = graphqlSelections(query, 'associatedPullRequests');
    if (association.length !== 1) die('graphql object requires associatedPullRequests');
    repository[objectSelection[0].alias] = {
      associatedPullRequests: commitAssociations(oid, association[0]),
    };
  } else if (labelSelections.length) {
    for (const selection of labelSelections) {
      for (const argument of selection.args.keys()) {
        if (argument !== 'name') die(`Unknown GraphQL argument: "${argument}"`);
      }
      const name = graphqlValue(selection.args.get('name'), variables);
      const stored = Object.keys(state.labels).find((label) => label.toLowerCase() === name?.toLowerCase());
      repository[selection.alias] = stored ? { name: stored } : null;
    }
  } else if (graphqlSelections(query, 'repository').length !== 1) {
    die('graphql query selects no repository');
  }
  respondGraphql(
    { ...(query.includes('viewer') && { viewer: { login: state.viewerLogin ?? '' } }), repository },
    stage,
  );
}

if (group === 'api' && command === 'user') {
  if (state.viewerError) die(state.viewerError);
  if (value('--jq') !== '.login') die('api user requires --jq .login');
  process.stdout.write(`${state.viewerLogin ?? ''}\n`);
  save();
  process.exit(0);
}

if (group === 'repo' && command === 'view') {
  if (state.repoError) die(state.repoError);
  const repo = value('--repo') ?? state.repo.nameWithOwner;
  const defaultBranch = state.repositoryDefaults?.[repo] ?? state.repo.defaultBranchRef?.name;
  const details = repo === state.repo.nameWithOwner
    ? state.repo
    : {
        nameWithOwner: repo,
        visibility: 'PUBLIC',
        defaultBranchRef: defaultBranch ? { name: defaultBranch } : null,
      };
  console.log(JSON.stringify(select(details, value('--json'))));
  save();
  process.exit(0);
}

if (group === 'label' && command === 'create') {
  const name = args[2];
  if (!name) die('label create requires a name');
  const existing = Object.keys(state.labels).find((label) => label.toLowerCase() === name.toLowerCase());
  if (existing && !args.includes('--force')) die(`label already exists: ${name}`);
  state.labels[existing ?? name] = {
    ...(existing && state.labels[existing]),
    color: value('--color') ?? 'ededed',
    ...(value('--description') !== undefined && { description: value('--description') }),
  };
  save();
  process.exit(0);
}

if (group === 'label' && command === 'list') {
  const entries = Object.keys(state.labels).sort().map((name) => ({ name }));
  console.log(JSON.stringify(entries.map((entry) => select(entry, value('--json')))));
  save();
  process.exit(0);
}

if (group === 'issue' && command === 'create') {
  const title = value('--title');
  const bodyFile = value('--body-file');
  if (!title || !bodyFile) die('issue create requires --title and --body-file');
  const number = state.nextIssue++;
  const now = new Date(Date.parse('2026-08-20T20:00:00Z') + (state.clock ?? 0) * 1000).toISOString();
  const issue = {
    number,
    title,
    body: fs.readFileSync(bodyFile, 'utf8'),
    state: 'OPEN',
    stateReason: null,
    labels: values('--label'),
    assignees: state.dropCreateAssignee
      ? []
      : values('--assignee').map((login) => login === '@me' ? state.viewerLogin : login),
    url: `https://github.com/${state.repo.nameWithOwner}/issues/${number}`,
    createdAt: now,
    updatedAt: now,
    comments: [],
    events: [],
  };
  state.issues.push(issue);
  console.log(issue.url);
  save();
  process.exit(0);
}

if (group === 'issue' && command === 'view') {
  const number = issueNumber();
  const issue = issueByNumber(number);
  validateJsonFields(value('--json'), ISSUE_JSON_FIELDS);
  observeIssue(issue);
  console.log(JSON.stringify(select(issueJson(issue), value('--json'))));
  save();
  process.exit(0);
}

if (group === 'issue' && command === 'edit') {
  const issue = issueByNumber(issueNumber());
  if (state.issueEditError) die(state.issueEditError);
  const bodyFile = value('--body-file');
  const addedAssignees = values('--add-assignee');
  const addedLabels = values('--add-label');
  const removedLabels = values('--remove-label');
  if (removedLabels.length > 0 && state.labelRemovalErrorOnce) {
    const message = state.labelRemovalErrorOnce;
    delete state.labelRemovalErrorOnce;
    die(message);
  }
  if (!bodyFile && addedAssignees.length === 0 && addedLabels.length === 0 && removedLabels.length === 0)
    die('issue edit requires a body, label, or assignee change');
  if (bodyFile) issue.body = fs.readFileSync(bodyFile, 'utf8');
  const same = (a, b) => a.toLowerCase() === b.toLowerCase();
  for (const name of removedLabels) issue.labels = issue.labels.filter((label) => !same(label, name));
  for (const name of addedLabels) if (!issue.labels.some((label) => same(label, name))) issue.labels.push(name);
  issue.assignees ??= [];
  if (!state.dropEditAssignee) {
    for (const login of addedAssignees.map((name) => name === '@me' ? state.viewerLogin : name)) {
      if (!issue.assignees.includes(login)) issue.assignees.push(login);
    }
  }
  touch(issue);
  save();
  process.exit(0);
}

if (group === 'issue' && command === 'list') {
  if (!value('--state') || !value('--limit')) die('issue list requires explicit --state and --limit');
  const requiredLabel = value('--label');
  const requestedState = value('--state');
  const limit = Number(value('--limit'));
  const fields = value('--json');
  validateJsonFields(fields, ISSUE_JSON_FIELDS);
  const issues = state.issues
    .filter((issue) => !requiredLabel || issue.labels.includes(requiredLabel))
    .filter((issue) => requestedState === 'all' || issue.state.toLowerCase() === requestedState)
    .slice(0, limit)
    .map((issue) => select(issueJson(issue), fields));
  console.log(JSON.stringify(issues));
  save();
  process.exit(0);
}

if (group === 'issue' && command === 'close') {
  const issue = issueByNumber(issueNumber());
  const reason = value('--reason');
  if (!new Set(['completed', 'not planned']).has(reason)) die('issue close requires a supported --reason');
  issue.state = 'CLOSED';
  issue.stateReason = reason === 'completed' ? 'COMPLETED' : 'NOT_PLANNED';
  touch(issue);
  save();
  process.exit(0);
}

if (group === 'pr' && command === 'view') {
  const number = Number(args[2]);
  const repo = value('--repo') ?? state.repo.nameWithOwner;
  validateJsonFields(value('--json'), PR_JSON_FIELDS);
  const pullRequest = state.prs.find((entry) => entry.number === number && entry.repository === repo);
  if (!pullRequest) die(`pull request not found: ${repo}#${number}`);
  console.log(JSON.stringify(select(pullRequest, value('--json'))));
  save();
  process.exit(0);
}

die(`unsupported gh command: ${args.join(' ')}`);
